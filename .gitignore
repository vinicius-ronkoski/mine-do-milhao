# Objetos e dependências gerados pelo make
build/*
!build/.gitkeep

# Executável
milhao
milhao.exe

# Dados gerados em tempo de execução (o CSV inicial vai para o Git)
data/perguntas.dat
data/exportados/*
!data/exportados/.gitkeep

# Editores / sistema
.vscode/
.idea/
*.swp
.DS_Store


# Executável do teste manual (tests/teste_arquivo.c)
teste_arquivo.c
teste_arquivo.exe
banco_falso.c
# tests/ é ignorada
tests/*

# Documentação local (só na máquina de quem escreveu; não vai para o Git)
docs/ARQUITETURA.md
docs/MUDANCAS.md

data/perguntas.dat.tmp

# imagens originais em resolução cheia (os jogos usam as versões 1280x720)
assets/originais/

# save do jogo (cada computador tem o seu)
data/save.txt
data/save.txt.tmp
