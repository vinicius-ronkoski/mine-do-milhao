# Objetos e dependências gerados pelo make
build/*
!build/.gitkeep

# Executável
milhao
milhao.exe

# Dados gerados em tempo de execução (o CSV inicial vai para o Git)
data/perguntas.dat
data/ranking.dat
data/exportados/*
!data/exportados/.gitkeep

# Editores / sistema
.vscode/
.idea/
*.swp
.DS_Store

# Executável do teste da partida (make teste)
teste_partida
teste_partida.exe

# Executável do teste manual (tests/teste_arquivo.c)
teste_arquivo.c
teste_arquivo.exe
banco_falso.c
# tests/ é ignorada
tests/*

# Documentação local (só na máquina de quem escreveu; não vai para o Git)
docs/ARQUITETURA.md
docs/MUDANCAS.md

data/perguntas.dat.tmp
